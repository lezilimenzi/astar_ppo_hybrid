<?xml version="1.0"?>
<robot name="iris_rplidar_depth">

  <!-- 본체 -->
  <link name="base_link">
    <inertial>
      <mass value="1.2"/> <!-- 대략값 -->
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.10"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <!-- z=-0.05: 본체를 아래쪽으로만 확장 → 위쪽(LiDAR 방향) collision 없음 -->
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- LiDAR -->
  <link name="rplidar_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="2e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Depth 카메라 -->
  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="4e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- 고정 조인트들: SDF에서 쓴 배치와 일치시키기 -->
  <joint name="rplidar_mount" type="fixed">
    <!-- LiDAR를 본체 위 z=0.25m (드론 본체 self-occlusion 방지) -->
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rplidar_link"/>
  </joint>

  <joint name="camera_mount" type="fixed">
    <!-- 카메라를 기체 전방 x=0.2m, z=0.1m (드론 본체 감지 방지) -->
    <origin xyz="0.20 0 0.10" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

</robot>
